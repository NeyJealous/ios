{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOS Agent Review Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["AgentId","AgentVersion","GateId","Branch","CommitSHA","ReviewScope","FilesReviewed","SpecificationReferences","ChecksPerformed","Findings","Severity","Evidence","RequiredFixes","ResidualRisk","Status","Timestamp","ExecutionMode"],
  "properties": {
    "AgentId": {"type":"string"}, "AgentVersion":{"type":"string"},
    "GateId":{"type":"string"}, "Branch":{"type":"string"},
    "CommitSHA":{"type":"string","pattern":"^[0-9a-f]{40}$"},
    "ReviewScope":{"type":"string"}, "FilesReviewed":{"type":"array","items":{"type":"string"}},
    "SpecificationReferences":{"type":"array","items":{"type":"string"}},
    "ChecksPerformed":{"type":"array","items":{"type":"string"}},
    "Findings":{"type":"array","items":{"type":"object","required":["Severity","Description"],"properties":{"Severity":{"enum":["INFO","LOW","MEDIUM","HIGH","CRITICAL","BLOCKER"]},"Description":{"type":"string"}}}},
    "Severity":{"enum":["INFO","LOW","MEDIUM","HIGH","CRITICAL","BLOCKER"]},
    "Evidence":{"type":"array","minItems":1,"items":{"type":"string"}},
    "RequiredFixes":{"type":"array","items":{"type":"string"}},
    "ResidualRisk":{"type":"string"},
    "Status":{"enum":["PASS","PASS_WITH_WARNINGS","BLOCKED","FAIL","NOT_APPLICABLE","NOT_EXECUTED"]},
    "Timestamp":{"type":"string","format":"date-time"},
    "ExecutionMode":{"enum":["REAL_SUBAGENT","CODEX_ROLE_SIMULATION","CI_VALIDATOR","MANUAL_REVIEW","NOT_AVAILABLE"]}
  }
}
