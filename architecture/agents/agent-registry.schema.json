{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NeyJealous/ios/architecture/agents/agent-registry.schema.json",
  "title": "IOS Agent Registry — zero-agent transition",
  "type": "object",
  "additionalProperties": false,
  "required": ["Version", "CanonicalBranch", "PlatformState", "ActiveCustomAgents", "MandatoryAgentAvailability", "ActivationAllowed", "Agents"],
  "properties": {
    "Version": { "const": "2.0.0-transition" },
    "CanonicalBranch": { "const": "integration/ios-current" },
    "PlatformState": { "const": "ZERO_AGENT_TRANSITION" },
    "ActiveCustomAgents": { "const": 0 },
    "MandatoryAgentAvailability": { "const": "NOT_AVAILABLE" },
    "ActivationAllowed": { "const": false },
    "Agents": { "const": [] }
  }
}
