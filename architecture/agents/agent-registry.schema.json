{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NeyJealous/ios/architecture/agents/agent-registry.schema.json",
  "title": "IOS Agent Registry — active-development first wave compatibility projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["Version", "CanonicalBranch", "PlatformState", "ActiveCustomAgents", "ProvisionedAgents", "MandatoryAgentAvailability", "ActivationAllowed", "SourceOfTruth", "Agents"],
  "properties": {
    "Version": { "enum": ["2.1.0-provisional", "2.1.0-development-active"] },
    "CanonicalBranch": { "const": "integration/ios-current" },
    "PlatformState": { "enum": ["PROVISIONAL_PLATFORM_BUILD", "FIRST_WAVE_ACTIVE_FOR_PROJECT_DEVELOPMENT"] },
    "ActiveCustomAgents": { "enum": [0, 5] },
    "ProvisionedAgents": { "const": 5 },
    "MandatoryAgentAvailability": { "enum": ["PROVISIONAL_AVAILABLE_ACTIVATION_CLOSED", "FIRST_WAVE_ACTIVE_FOR_PROJECT_DEVELOPMENT"] },
    "ActivationAllowed": { "type": "boolean" },
    "SourceOfTruth": { "const": "architecture/agents/registry/agents.yaml" },
    "Agents": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["AgentId", "Name", "SpecificationSources", "Purpose", "Scope", "Triggers", "RequiredInputs", "Checks", "ForbiddenActions", "RequiredOutputs", "SeverityLevels", "BlockingLevels", "CanModifyCode", "CanModifyDocs", "CanUseNetwork", "CanUseMCP", "CanWriteRemote", "CanApproveMerge", "CanDeploy", "CanProductionWrite", "CanModifySecrets", "Escalation", "FallbackMode", "Version", "Status", "ActivationEligible", "OverlayPath", "CompositionPath", "GeneratedProfilePath"],
        "properties": {
          "AgentId": { "enum": ["ios-agent-orchestrator", "agent-governance-auditor", "security-privacy-auditor", "audit-traceability-reviewer", "ios-codebase-auditor"] },
          "Status": { "enum": ["PROVISIONAL", "IMPLEMENTED"] },
          "ActivationEligible": { "type": "boolean" },
          "CanWriteRemote": { "const": false },
          "CanApproveMerge": { "const": false },
          "CanDeploy": { "const": false },
          "CanProductionWrite": { "const": false },
          "CanModifySecrets": { "const": false }
        }
      }
    }
  }
}
