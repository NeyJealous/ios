{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/NeyJealous/ios/architecture/agents/review-matrix.schema.json",
  "title": "IOS Review Matrix — zero-agent transition",
  "type": "object",
  "additionalProperties": false,
  "required": ["Version","PlatformState","TaskTypes","AlwaysRequiredAgents","BaselineControls","Rules","FailClosed","Transition"],
  "properties": {
    "Version": {"const":"2.0.0-transition"},
    "PlatformState": {"const":"ZERO_AGENT_TRANSITION"},
    "TaskTypes": {"type":"array","minItems":19,"uniqueItems":true,"items":{"type":"string"}},
    "AlwaysRequiredAgents": {"const":[]},
    "BaselineControls": {"type":"array","contains":{"const":"zero-agent-fail-closed"},"minContains":1},
    "Rules": {"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["RuleId","TaskType","PathPatterns","RequiredAgents","RequiredControls"],"properties":{"RuleId":{"type":"string","pattern":"^[A-Z0-9_-]+$"},"TaskType":{"type":"string"},"PathPatterns":{"type":"array","items":{"type":"string"}},"BranchPatterns":{"type":"array","items":{"type":"string"}},"RequiredAgents":{"const":[]},"RequiredControls":{"type":"array","uniqueItems":true,"items":{"type":"string"}},"Reason":{"type":"string"}}}},
    "FailClosed": {"type":"object","additionalProperties":false,"required":["UnknownTaskType","EmptyDiff","RequiredAgents","MandatoryAvailability","OverallResult"],"properties":{"UnknownTaskType":{"const":"mixed/unknown"},"EmptyDiff":{"const":"BLOCK"},"RequiredAgents":{"const":[]},"MandatoryAvailability":{"const":"NOT_AVAILABLE"},"OverallResult":{"const":"BLOCKED"}}},
    "Transition": {"type":"object","additionalProperties":false,"required":["ActiveCustomAgents","OldRegistryReferences","OldMatrixReferences","OldResolverReferences","OldManifestsAccepted","ResolverBehavior"],"properties":{"ActiveCustomAgents":{"const":0},"OldRegistryReferences":{"const":0},"OldMatrixReferences":{"const":0},"OldResolverReferences":{"const":0},"OldManifestsAccepted":{"const":false},"ResolverBehavior":{"const":"FAIL_CLOSED"}}},
    "AntiTamperPaths": {"type":"array","items":{"type":"string"}},
    "ExceptionPolicy": {"type":"object"}
  }
}
