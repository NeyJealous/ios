{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IOS Versioned Agent Governance Exception",
  "type": "object",
  "additionalProperties": false,
  "required": ["ExceptionId", "RfcAdrReference", "OwnerApproval", "Reason", "Expiry", "RiskAcceptance", "ExcludedAgents"],
  "properties": {
    "ExceptionId": { "type": "string", "pattern": "^EX-[A-Z0-9-]+$" },
    "RfcAdrReference": { "type": "string", "pattern": "^(RFC|ADR)-" },
    "OwnerApproval": { "type": "string", "minLength": 3 },
    "Reason": { "type": "string", "minLength": 10 },
    "Expiry": { "type": "string", "format": "date-time" },
    "RiskAcceptance": { "type": "string", "minLength": 10 },
    "ExcludedAgents": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } }
  }
}
